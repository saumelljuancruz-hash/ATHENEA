  "pieces": [
    {
      "id": "gancho",
      "sentences": [
        {
          "text": "Nadie te ve como te ves en el ESPEJO.",
          "start": 0,
          "end": 63
        }
      ],
      "from": 0,
      "durationInFrames": 73
    },
    {
      "id": "intro",
      "sentences": [
        {
          "text": "Por eso odiás tus SELFIES.",
          "start": 0,
          "end": 39
        },
        {
          "text": "Al final, el TRUCO para arreglarlo.",
          "start": 56,
          "end": 117
        }
      ],
      "from": 73,
      "durationInFrames": 130
    },
    {
      "id": "cuerpo1",
      "sentences": [
        {
          "text": "El espejo te muestra al REVÉS.",
          "start": 0,
          "end": 48
        },
        {
          "text": "Y ninguna cara es SIMÉTRICA: un ojo más alto, una sonrisa torcida, la raya del pelo.",
          "start": 60,
          "end": 211
        },
        {
          "text": "Vos te viste al revés TODA LA VIDA.",
          "start": 222,
          "end": 273
        },
        {
          "text": "La cámara te muestra al derecho, y tu cerebro dice: algo está MAL.",
          "start": 285,
          "end": 402
        }
      ],
      "from": 203,
      "durationInFrames": 413
    },
    {
      "id": "bucle1",
      "sentences": [
        {
          "text": "Pero tu cerebro hace TRAMPA.",
          "start": 0,
          "end": 46
        }
      ],
      "from": 616,
      "durationInFrames": 60
    },
    {
      "id": "cuerpo2",
      "sentences": [
        {
          "text": "En 1977 lo probaron: fotografiaron a un grupo de mujeres y les mostraron su foto normal y espejada.",
          "start": 0,
          "end": 192
        },
        {
          "text": "Ellas eligieron la ESPEJADA.",
          "start": 192,
          "end": 244
        },
        {
          "text": "Sus amigos, la NORMAL.",
          "start": 255,
          "end": 289
        },
        {
          "text": "Te gusta la cara que más VISTE.",
          "start": 302,
          "end": 354
        }
      ],
      "from": 676,
      "durationInFrames": 367
    },
    {
      "id": "bucle2",
      "sentences": [
        {
          "text": "Y la cámara frontal te hace algo PEOR.",
          "start": 0,
          "end": 68
        }
      ],
      "from": 1043,
      "durationInFrames": 77
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "Es GRAN ANGULAR y la tenés a unos 30 centímetros.",
          "start": 0,
          "end": 82
        },
        {
          "text": "A esa distancia, tu nariz se ve un 30% más ANCHA.",
          "start": 93,
          "end": 192
        },
        {
          "text": "El espejo te muestra desde el DOBLE de lejos.",
          "start": 201,
          "end": 271
        },
        {
          "text": "Truco: ALEJÁ el celular y hacé ZOOM.",
          "start": 279,
          "end": 352
        }
      ],
      "from": 1120,
      "durationInFrames": 360
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "GUARDALO para tu próxima selfie.",
          "start": 0,
          "end": 45
        },
        {
          "text": "Y SEGUÍ a @nadietelo.explico para más datos así.",
          "start": 57,
          "end": 134
        }
      ],
      "from": 1480,
      "durationInFrames": 187
    }
  ],
