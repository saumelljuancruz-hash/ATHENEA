  "pieces": [
    {
      "id": "gancho",
      "sentences": [
        {
          "text": "Tu dedo está moviendo ELECTRICIDAD.",
          "start": 0,
          "end": 46
        },
        {
          "text": "Ahora MISMO.",
          "start": 52,
          "end": 73
        }
      ],
      "from": 0,
      "durationInFrames": 85
    },
    {
      "id": "intro",
      "sentences": [
        {
          "text": "Un rayo también… con 300 MILLONES de voltios.",
          "start": 0,
          "end": 89
        },
        {
          "text": "Al final vas a saber si viene HACIA VOS.",
          "start": 97,
          "end": 150
        }
      ],
      "from": 85,
      "durationInFrames": 166
    },
    {
      "id": "cuerpo1",
      "sentences": [
        {
          "text": "Una nube de tormenta mide 15 KILÓMETROS: casi dos EVEREST.",
          "start": 0,
          "end": 105
        },
        {
          "text": "Adentro, vientos de 100 KM/H hacen chocar millones de piedritas de HIELO.",
          "start": 122,
          "end": 255
        },
        {
          "text": "Cada choque arranca CARGA, como la ESTÁTICA que junta polvo en tu pantalla.",
          "start": 260,
          "end": 369
        },
        {
          "text": "Arriba, POSITIVO. Abajo, NEGATIVO.",
          "start": 381,
          "end": 452
        },
        {
          "text": "Una PILA gigante.",
          "start": 462,
          "end": 500
        }
      ],
      "from": 251,
      "durationInFrames": 512
    },
    {
      "id": "bucle1",
      "sentences": [
        {
          "text": "Pero el rayo te ENGAÑA.",
          "start": 0,
          "end": 40
        }
      ],
      "from": 763,
      "durationInFrames": 49
    },
    {
      "id": "cuerpo2",
      "sentences": [
        {
          "text": "No baja: SUBE.",
          "start": 0,
          "end": 36
        },
        {
          "text": "Primero cae un camino INVISIBLE, a saltos.",
          "start": 36,
          "end": 117
        },
        {
          "text": "Al tocar el suelo, el destello sube a 100.000 KILÓMETROS por segundo.",
          "start": 124,
          "end": 224
        }
      ],
      "from": 812,
      "durationInFrames": 235
    },
    {
      "id": "bucle2",
      "sentences": [
        {
          "text": "Y lo más LOCO está adentro.",
          "start": 0,
          "end": 52
        }
      ],
      "from": 1047,
      "durationInFrames": 61
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "Ese canal es del ancho de tu DEDO.",
          "start": 0,
          "end": 55
        },
        {
          "text": "Pero llega a 30.000 GRADOS: cinco veces la superficie del SOL.",
          "start": 60,
          "end": 176
        },
        {
          "text": "El aire EXPLOTA, y eso es el TRUENO.",
          "start": 188,
          "end": 264
        },
        {
          "text": "Contá los segundos hasta escucharlo y dividí por TRES: esos son los KILÓMETROS.",
          "start": 274,
          "end": 393
        },
        {
          "text": "Si el número BAJA, viene hacia VOS.",
          "start": 405,
          "end": 454
        }
      ],
      "from": 1108,
      "durationInFrames": 467
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "GUARDALO para la próxima tormenta.",
          "start": 0,
          "end": 46
        },
        {
          "text": "Y SEGUÍ a @nadietelo.explico para más datos así.",
          "start": 55,
          "end": 125
        }
      ],
      "from": 1575,
      "durationInFrames": 178
    }
  ],
