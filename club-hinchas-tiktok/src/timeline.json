  "pieces": [
    {
      "id": "gancho",
      "sentences": [
        {
          "text": "Fundé un club de FÚTBOL, y la hinchada sos VOS.",
          "start": 0,
          "end": 83
        }
      ],
      "from": 0,
      "durationInFrames": 95
    },
    {
      "id": "intro",
      "sentences": [
        {
          "text": "La cancha tiene lugar para 1.000. Y ya está casi LLENA.",
          "start": 0,
          "end": 84
        },
        {
          "text": "Al final te digo cómo ENTRÁS.",
          "start": 95,
          "end": 131
        }
      ],
      "from": 95,
      "durationInFrames": 143
    },
    {
      "id": "cuerpo1",
      "sentences": [
        {
          "text": "Cada persona que sigue la cuenta es un HINCHA más sentado en la tribuna.",
          "start": 0,
          "end": 100
        },
        {
          "text": "Cuando se llena, nos MUDAMOS: primero a 10.000 lugares, y después a un estadio de 100.000.",
          "start": 112,
          "end": 273
        }
      ],
      "from": 238,
      "durationInFrames": 284
    },
    {
      "id": "bucle1",
      "sentences": [
        {
          "text": "Pero al club le falta lo más IMPORTANTE.",
          "start": 0,
          "end": 60
        }
      ],
      "from": 522,
      "durationInFrames": 76
    },
    {
      "id": "cuerpo2",
      "sentences": [
        {
          "text": "No tiene NOMBRE. No tiene ESCUDO. Ni COLORES.",
          "start": 0,
          "end": 85
        },
        {
          "text": "Lo deciden ustedes en los COMENTARIOS: gana el más votado.",
          "start": 97,
          "end": 190
        }
      ],
      "from": 598,
      "durationInFrames": 202
    },
    {
      "id": "bucle2",
      "sentences": [
        {
          "text": "Y desde mañana, JUEGA.",
          "start": 0,
          "end": 41
        }
      ],
      "from": 800,
      "durationInFrames": 48
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "Una liga de 10 equipos, una FECHA por día, contra rivales como Big Bang o Agujero Negro.",
          "start": 0,
          "end": 156
        },
        {
          "text": "No vas a ver los partidos: solo los RESULTADOS.",
          "start": 168,
          "end": 242
        },
        {
          "text": "Y acá está la clave: cuanta más gente en la cancha, más FUERTE juega de local.",
          "start": 255,
          "end": 389
        }
      ],
      "from": 848,
      "durationInFrames": 403
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "COMENTÁ cómo se tiene que llamar el club.",
          "start": 0,
          "end": 57
        },
        {
          "text": "Y SEGUÍ a @nadietelo.explico para entrar a la cancha.",
          "start": 68,
          "end": 147
        }
      ],
      "from": 1251,
      "durationInFrames": 199
    }
  ],
