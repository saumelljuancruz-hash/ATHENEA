    },
    {
      "id": "partido",
      "sentences": [
        {
          "text": "Con 1.175 hinchas empujando, le metimos 6 goles a Juventud Tsunami.",
          "start": 0,
          "end": 143
        }
      ],
      "from": 92,
      "durationInFrames": 153
    },
    {
      "id": "tabla",
      "sentences": [
        {
          "text": "Subimos al CUARTO puesto, a un punto de los de arriba.",
          "start": 0,
          "end": 83
        }
      ],
      "from": 245,
      "durationInFrames": 95
    },
    {
      "id": "bengalas",
      "sentences": [
        {
          "text": "Y desde hoy hay algo nuevo: las BENGALAS.",
          "start": 0,
          "end": 82
        },
        {
          "text": "Cada vez que compartís un video, se prende una bengala en la tribuna.",
          "start": 90,
          "end": 184
        }
      ],
      "from": 340,
      "durationInFrames": 192
    },
    {
      "id": "regla",
      "sentences": [
        {
          "text": "Cada bengala suma 0,05% de chance de ganar el próximo partido de LOCAL, y el rival entra con MIEDO.",
          "start": 0,
          "end": 204
        }
      ],
      "from": 532,
      "durationInFrames": 213
    },
    {
      "id": "numeros",
      "sentences": [
        {
          "text": "Contra Agujero Negro, en la fecha 5, sin bengalas tenemos un 44%.",
          "start": 0,
          "end": 142
        },
        {
          "text": "Con 500 bengalas, un 69%.",
          "start": 142,
          "end": 238
        },
        {
          "text": "Y con 1.000, llegamos al 90%.",
          "start": 238,
          "end": 322
        }
      ],
      "from": 745,
      "durationInFrames": 322
    },
    {
      "id": "manana",
      "sentences": [
        {
          "text": "Pero antes, mañana, visitamos a Gravedad.",
          "start": 0,
          "end": 86
        }
      ],
      "from": 1067,
      "durationInFrames": 92
    },
    {
      "id": "cta",
