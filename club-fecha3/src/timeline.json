    {
      "id": "gancho",
      "sentences": [
        {
          "text": "¡6 a 2! La REVANCHA llegó de local.",
          "start": 0,
          "end": 83
        }
      ],
      "from": 0,
      "durationInFrames": 95
    },
    {
      "id": "partido",
      "sentences": [
        {
          "text": "Con 1.175 hinchas empujando, le metimos 6 goles a Juventud Tsunami.",
          "start": 0,
          "end": 140
        }
      ],
      "from": 95,
      "durationInFrames": 150
    },
    {
      "id": "tabla",
      "sentences": [
        {
          "text": "Subimos al CUARTO puesto, a un punto de los de arriba.",
          "start": 0,
          "end": 84
        }
      ],
      "from": 245,
      "durationInFrames": 95
    },
    {
      "id": "bengalas",
      "sentences": [
        {
          "text": "Y desde hoy hay algo nuevo: las BENGALAS.",
          "start": 0,
          "end": 82
        },
        {
          "text": "Cada vez que compartís un video, se prende una bengala en la tribuna.",
          "start": 90,
          "end": 187
        }
      ],
      "from": 340,
      "durationInFrames": 200
    },
    {
      "id": "regla",
      "sentences": [
        {
          "text": "Las bengalas suman fuerza en el próximo partido de LOCAL, y el rival entra con MIEDO.",
          "start": 0,
          "end": 139
        }
      ],
      "from": 540,
      "durationInFrames": 151
    },
    {
      "id": "numeros",
      "sentences": [
        {
          "text": "Contra Agujero Negro, en la fecha 5, sin bengalas tenemos un 44% de ganar.",
          "start": 0,
          "end": 156
        },
        {
          "text": "Con 50, un 57%.",
          "start": 156,
          "end": 238
        }
      ],
      "from": 691,
      "durationInFrames": 238
    },
    {
      "id": "manana",
      "sentences": [
        {
          "text": "Pero antes, mañana, visitamos a Gravedad.",
          "start": 0,
          "end": 84
        }
      ],
      "from": 929,
      "durationInFrames": 91
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "COMPARTILO para prender la primera BENGALA.",
