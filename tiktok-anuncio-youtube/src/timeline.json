      ],
      "from": 345,
      "durationInFrames": 142
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "¿Dónde está? El link está en mi PERFIL.",
          "start": 0,
          "end": 64
        },
        {
          "text": "Tocá mi foto, entrá al link y SUSCRIBITE.",
          "start": 72,
          "end": 144
        }
