   "sentences": [
    {
     "text": "¡3 a 0 en contra! ¿Y aun así le podemos ganar al TERCERO?",
     "start": 0,
     "end": 104
    },
    {
     "text": "La respuesta la prendieron ustedes.",
     "start": 117,
     "end": 168
    }
   ],
   "from": 0,
   "durationInFrames": 184
  },
  {
   "id": "partido",
   "sentences": [
    {
     "text": "De visitante no suma la hinchada: contra Gravedad teníamos un 6% de chance.",
     "start": 0,
     "end": 144
    }
   ],
   "from": 184,
   "durationInFrames": 159
  },
  {
   "id": "tabla",
   "sentences": [
    {
     "text": "Bajamos del cuarto al SÉPTIMO puesto, a cuatro puntos del puntero.",
     "start": 0,
     "end": 112
    }
   ],
   "from": 343,
   "durationInFrames": 119
  },
  {
   "id": "hinchas",
   "sentences": [
    {
     "text": "Pero la tribuna no para: ya somos 1.307 hinchas, 132 más que ayer.",
     "start": 0,
     "end": 170
    }
   ],
   "from": 462,
   "durationInFrames": 179
  },
  {
   "id": "bengalas",
   "sentences": [
    {
     "text": "Y el video de ayer tuvo 421 compartidos.",
     "start": 0,
     "end": 93
    },
    {
     "text": "O sea: 421 BENGALAS prendidas para mañana.",
     "start": 102,
     "end": 206
    }
   ],
   "from": 641,
   "durationInFrames": 206
  },
  {
   "id": "numeros",
   "sentences": [
    {
     "text": "Mañana jugamos de local contra Agujero Negro.",
     "start": 0,
     "end": 84
    },
    {
     "text": "Sin bengalas, la chance era 45%.",
     "start": 94,
     "end": 186
    },
    {
     "text": "Con estas 421… ¡66%!",
     "start": 186,
     "end": 307
    }
   ],
   "from": 847,
   "durationInFrames": 307
  },
  {
   "id": "faltan",
   "sentences": [
    {
     "text": "Y con 905 bengalas tocamos el tope: 90%.",
     "start": 0,
     "end": 131
    },
    {
     "text": "Faltan solo 484.",
     "start": 131,
     "end": 195
    }
   ],
   "from": 1154,
   "durationInFrames": 209
  },
  {
   "id": "cta",
   "sentences": [
    {
