  "pieces": [
    {
      "id": "gancho",
      "sentences": [
        {
          "text": "6.300 MILLONES de dólares en 20 minutos: el mayor ROBO cripto de la historia.",
          "start": 0,
          "end": 160
        }
      ],
      "from": 0,
      "durationInFrames": 160
    },
    {
      "id": "intro",
      "sentences": [
        {
          "text": "Fue contra BINANCE.",
          "start": 0,
          "end": 42
        },
        {
          "text": "Al final, qué pasa con TU PLATA.",
          "start": 53,
          "end": 100
        }
      ],
      "from": 160,
      "durationInFrames": 116
    },
    {
      "id": "cuerpo1",
      "sentences": [
        {
          "text": "Todo empezó con la LAPTOP de un ingeniero.",
          "start": 0,
          "end": 59
        },
        {
          "text": "Desde ahí llegaron al sistema que FIRMA los retiros, como tu huella al pagar.",
          "start": 70,
          "end": 178
        },
        {
          "text": "Prepararon 50 FIRMAS por adelantado.",
          "start": 187,
          "end": 252
        },
        {
          "text": "Con que una sirviera, alcanzaba. Y SIRVIÓ.",
          "start": 259,
          "end": 350
        }
      ],
      "from": 276,
      "durationInFrames": 361
    },
    {
      "id": "bucle1",
      "sentences": [
        {
          "text": "Y ahí empezó la CARRERA.",
          "start": 0,
          "end": 39
        }
      ],
      "from": 637,
      "durationInFrames": 48
    },
    {
      "id": "cuerpo2",
      "sentences": [
        {
          "text": "En un solo movimiento se llevaron 2.500 MILLONES.",
          "start": 0,
          "end": 87
        },
        {
          "text": "En 20 minutos vaciaron billeteras en 10 BLOCKCHAINS.",
          "start": 103,
          "end": 190
        },
        {
          "text": "TRM Labs y Chainalysis apuntan a COREA DEL NORTE.",
          "start": 190,
          "end": 286
        }
      ],
      "from": 685,
      "durationInFrames": 300
    },
    {
      "id": "bucle2",
      "sentences": [
        {
          "text": "Pero no todo salió como QUERÍAN.",
          "start": 0,
          "end": 51
        }
      ],
      "from": 985,
      "durationInFrames": 63
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "Más de la mitad eran DÓLARES DIGITALES.",
          "start": 0,
          "end": 58
        },
        {
          "text": "Tether y Circle empezaron a CONGELARLOS en menos de una hora: casi 3.000 millones, trabados.",
          "start": 63,
          "end": 222
        },
        {
          "text": "Bitcoin y ether no se congelan: 2.400 millones siguen con los HACKERS.",
          "start": 231,
          "end": 357
        },
        {
          "text": "¿Y tu plata? Binance dice que ya repuso el 90% con fondos propios.",
          "start": 370,
          "end": 494
        }
      ],
      "from": 1048,
      "durationInFrames": 501
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "MANDÁSELO a alguien que tenga cripto.",
          "start": 0,
          "end": 51
        },
        {
          "text": "Y SEGUÍ a @nadietelo.explico para más datos así.",
          "start": 56,
          "end": 127
        }
      ],
      "from": 1549,
      "durationInFrames": 179
    }
