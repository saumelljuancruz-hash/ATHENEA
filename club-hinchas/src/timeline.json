  "pieces": [
    {
      "id": "gancho",
      "sentences": [
        {
          "text": "Fundé un club de FÚTBOL, y la hinchada sos VOS.",
          "start": 0,
          "end": 81
        }
      ],
      "from": 0,
      "durationInFrames": 92
    },
    {
      "id": "intro",
      "sentences": [
        {
          "text": "La cancha tiene lugar para 100. Y está casi VACÍA.",
          "start": 0,
          "end": 88
        },
        {
          "text": "Al final te digo cómo ENTRÁS.",
          "start": 97,
          "end": 133
        }
      ],
      "from": 92,
      "durationInFrames": 144
    },
    {
      "id": "cuerpo1",
      "sentences": [
        {
          "text": "Cada persona que sigue la cuenta es un HINCHA más sentado en la tribuna.",
          "start": 0,
          "end": 102
        },
        {
          "text": "Cuando se llena, nos MUDAMOS: 1.000 lugares, después 10.000, y así hasta un estadio de 100.000.",
          "start": 112,
          "end": 278
        }
      ],
      "from": 236,
      "durationInFrames": 288
    },
    {
      "id": "bucle1",
      "sentences": [
        {
          "text": "Pero al club le falta lo más IMPORTANTE.",
          "start": 0,
          "end": 56
        }
      ],
      "from": 524,
      "durationInFrames": 71
    },
    {
      "id": "cuerpo2",
      "sentences": [
        {
          "text": "No tiene NOMBRE. No tiene ESCUDO. Ni COLORES.",
          "start": 0,
          "end": 82
        },
        {
          "text": "Lo deciden ustedes en los COMENTARIOS: gana el más votado.",
          "start": 95,
          "end": 187
        }
      ],
      "from": 595,
      "durationInFrames": 197
    },
    {
      "id": "bucle2",
      "sentences": [
        {
          "text": "Y desde mañana, JUEGA.",
          "start": 0,
          "end": 40
        }
      ],
      "from": 792,
      "durationInFrames": 50
    },
    {
      "id": "final",
      "sentences": [
        {
          "text": "Una liga de 10 equipos, una FECHA por día, contra rivales como Big Bang o Agujero Negro.",
          "start": 0,
          "end": 156
        },
        {
          "text": "No vas a ver los partidos: solo los RESULTADOS.",
          "start": 168,
          "end": 240
        },
        {
          "text": "Y acá está la clave: cuanta más gente en la cancha, más FUERTE juega de local.",
          "start": 254,
          "end": 381
        }
      ],
      "from": 842,
      "durationInFrames": 395
    },
    {
      "id": "cta",
      "sentences": [
        {
          "text": "COMENTÁ cómo se tiene que llamar el club.",
          "start": 0,
          "end": 57
        },
        {
          "text": "Y SEGUÍ a @nadietelo.explico para entrar a la cancha.",
          "start": 67,
          "end": 145
        }
      ],
      "from": 1237,
      "durationInFrames": 197
    }
  ],
